  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SmartTraining.ModelDisassemblyAnimation
  disassemblyClip: {fileID: 7400000, guid: 03d676e7b2de28740bf3358ac2051b71, type: 2}
  steps:
  - time: 0
    title: "\uBCF4\uD638 \uBAA8\uC790 \uBD84\uB9AC"
    description: "\uBCF4\uD638 \uBAA8\uC790\uB97C \uC704\uB85C \uB744\uC6CC \uCC59\uACFC\uC758
      \uC704\uCE58 \uAD00\uACC4\uB97C \uC0B4\uD3B4\uBD05\uB2C8\uB2E4."
    targets:
    - {fileID: 5200675696423159064}
  - time: 1
    title: "\uCC59 \uBD84\uB9AC"
    description: "\uC544\uB798\uB85C \uBD84\uB9AC\uB41C \uCC59\uC758 \uD615\uD0DC\uC640
      \uBA38\uB9AC \uBCF4\uD638 \uC7A5\uBE44\uC758 \uAD6C\uC131\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
    targets:
    - {fileID: 3489247951280725781}
  - time: 2
    title: "\uC67C\uCABD \uB80C\uC988 \uBD84\uB9AC"
    description: "\uC67C\uCABD \uB80C\uC988\uB97C \uBC14\uAE65\uCABD\uC73C\uB85C
      \uBD84\uB9AC\uD574 \uC5F0\uACB0\uBD80\uC640 \uB9DE\uB2FF\uB294 \uC704\uCE58\uB97C
      \uC0B4\uD3B4\uBD05\uB2C8\uB2E4."
    targets:
    - {fileID: 679387848044980766}
  - time: 3
    title: "\uC624\uB978\uCABD \uB80C\uC988 \uBD84\uB9AC"
    description: "\uC624\uB978\uCABD \uB80C\uC988\uB97C \uBD84\uB9AC\uD574 \uC88C\uC6B0
      \uB80C\uC988\uC758 \uBC30\uCE58\uB97C \uBE44\uAD50\uD569\uB2C8\uB2E4."
    targets:
    - {fileID: 4405177182747271461}
  - time: 4
    title: "\uC5F0\uACB0\uBD80 \uD655\uC778"
    description: "\uB80C\uC988 \uC0AC\uC774\uC758 \uC5F0\uACB0\uBD80\uB97C \uBD84\uB9AC\uD574
      \uC804\uCCB4 \uAD6C\uC131\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. \uC7AC\uC870\uB9BD\uD558\uBA74
      \uC6D0\uB798 \uC704\uCE58\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    targets:
    - {fileID: 7289655328735701050}
