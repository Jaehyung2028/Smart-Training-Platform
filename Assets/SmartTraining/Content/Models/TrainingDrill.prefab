  m_Script: {fileID: 11500000, guid: e852e5aa74794e889f1777d76ce31c03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SmartTraining.ModelDisassemblyAnimation
  disassemblyClip: {fileID: 7400000, guid: ad356976742d143479a285f34d0db716, type: 2}
  steps:
  - time: 0
    title: "\uBC30\uD130\uB9AC \uBD84\uB9AC"
    description: "\uC804\uC6D0\uBD80\uAC00 \uC544\uB798\uB85C \uBD84\uB9AC\uB418\uB294
      \uACFC\uC815\uC744 \uD655\uC778\uD558\uC138\uC694. \uBC30\uD130\uB9AC\uC640
      \uBC1B\uCE68\uC774 \uD558\uB098\uC758 \uBB36\uC74C\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    targets:
    - {fileID: 1504037366065233320}
  - time: 1
    title: "\uBE44\uD2B8 \uBD84\uB9AC"
    description: "\uC55E\uCABD\uC73C\uB85C \uC774\uB3D9\uD558\uB294 \uB4DC\uB9B4
      \uBE44\uD2B8\uB97C \uD655\uC778\uD558\uC138\uC694. \uBE44\uD2B8\uAC00 \uCC99\uC5D0\uC11C
      \uBD84\uB9AC\uB418\uB294 \uBC29\uD5A5\uC744 \uC0B4\uD3B4\uBD05\uB2C8\uB2E4."
    targets:
    - {fileID: 8367543287265105045}
  - time: 2
    title: "\uCC99 \uBD84\uB9AC"
    description: "\uBE44\uD2B8\uB97C \uACE0\uC815\uD558\uB294 \uCC99\uC774 \uC55E\uCABD\uC73C\uB85C
      \uBD84\uB9AC\uB429\uB2C8\uB2E4. \uBE44\uD2B8\uC640 \uCC99\uC758 \uC5F0\uACB0
      \uAD6C\uC870\uB97C \uD655\uC778\uD558\uC138\uC694."
    targets:
    - {fileID: 5112556350331943097}
  - time: 3
    title: "\uC678\uC7A5 \uBD84\uB9AC"
    description: "\uBAA8\uD130 \uC870\uB9BD\uCCB4\uC640 \uC190\uC7A1\uC774 \uBB36\uC74C\uC774
      \uC591\uCABD\uC73C\uB85C \uBC8C\uC5B4\uC9D1\uB2C8\uB2E4. \uC190\uC7A1\uC774\uC758
      \uD68C\uC804\uACFC \uC678\uC7A5 \uB0B4\uBD80\uC758 \uC704\uCE58 \uAD00\uACC4\uB97C
      \uD655\uC778\uD558\uC138\uC694."
    targets:
    - {fileID: 8862763030198466173}
    - {fileID: 7748467576218538036}
  - time: 4
    title: "\uD1B5\uD48D\uBD80 \uD655\uC778"
    description: "\uBAA8\uD130 \uC870\uB9BD\uCCB4\uC5D0\uC11C \uD1B5\uD48D\uBD80\uAC00
      \uBD84\uB9AC\uB418\uB294 \uACFC\uC815\uC744 \uC0B4\uD3B4\uBD05\uB2C8\uB2E4.
      \uC7AC\uC870\uB9BD\uC744 \uB204\uB974\uBA74 \uACFC\uC815\uC744 \uC5ED\uBC29\uD5A5\uC73C\uB85C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    targets:
    - {fileID: 7285242934731961083}
