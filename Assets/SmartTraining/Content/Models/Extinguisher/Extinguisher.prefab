  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SmartTraining.ModelDisassemblyAnimation
  disassemblyClip: {fileID: 7400000, guid: 3cb38b6255d8d714ea0a7d88b9a5d896, type: 2}
  steps:
  - time: 0
    title: "\uC548\uC804\uD540 \uBD84\uB9AC"
    description: "\uC548\uC804\uD540\uC744 \uC606\uC73C\uB85C \uBD84\uB9AC\uD574
      \uC190\uC7A1\uC774\uC640\uC758 \uC704\uCE58 \uAD00\uACC4\uB97C \uC0B4\uD3B4\uBD05\uB2C8\uB2E4.
      \uC2E4\uC81C \uC0AC\uC6A9\xB7\uC815\uBE44 \uC808\uCC28\uAC00 \uC544\uB2CC \uAD6C\uC870
      \uAD00\uCC30\uC6A9 \uD45C\uD604\uC785\uB2C8\uB2E4."
    targets:
    - {fileID: 2372238606580478253}
  - time: 1
    title: "\uC190\uC7A1\uC774 \uBD84\uB9AC"
    description: "\uC190\uC7A1\uC774\uB97C \uC704\uB85C \uB744\uC6CC \uC6A9\uAE30
      \uC0C1\uB2E8\uACFC \uC5F0\uACB0\uB418\uB294 \uAD6C\uC870\uB97C \uD655\uC778\uD569\uB2C8\uB2E4."
    targets:
    - {fileID: 2324850195493028917}
  - time: 2
    title: "\uD638\uC2A4 \uBD84\uB9AC"
    description: "\uD638\uC2A4\uB97C \uC606\uC73C\uB85C \uBD84\uB9AC\uD574 \uC6A9\uAE30\uC640
      \uD638\uC2A4\uC758 \uBC30\uCE58\uB97C \uC0B4\uD3B4\uBD05\uB2C8\uB2E4."
    targets:
    - {fileID: 3331915356381247448}
  - time: 3
    title: "\uBC1B\uCE68 \uBD84\uB9AC"
    description: "\uc55e\ucabd\uc73c\ub85c \ubd84\ub9ac\ub41c \ubc1b\uce68\uc744 \uc0b4\ud3b4\ubcf4\uace0 \uc6a9\uae30 \ud558\ub2e8\uc758 \uc9c0\uc9c0 \uc704\uce58\ub97c \ud655\uc778\ud569\ub2c8\ub2e4."
    targets:
    - {fileID: 6266795084089815968}
  - time: 4
    title: "\uC6A9\uAE30\uC640 \uC804\uCCB4 \uAD6C\uC870 \uD655\uC778"
