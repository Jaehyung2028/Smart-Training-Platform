    targetId: tool-bolt
    action: 1
    durationSeconds: 3
    requiredRole: 0
  - id: use-screwdriver
    title: "\uC2ED\uC790 \uB4DC\uB77C\uC774\uBC84 \xB7 \uB098\uC0AC \uD480\uAE30"
