    targetId: guard-warning
    action: 0
    durationSeconds: 1.5
    requiredRole: 1
  - id: release-guard
    title: "\uB36E\uAC1C \uACE0\uC815 \uBCFC\uD2B8 \uD480\uAE30"
    instruction: "\uC815\uBE44 \uB2F4\uB2F9: \uC2A4\uD328\uB108\uB85C BOLT\uB97C
