  title: "\uD611\uB3D9 \uBC29\uD638 \uB36E\uAC1C \uBCF5\uAD6C"
  steps:
  - id: inspect-guard
    title: "\uBC29\uD638 \uB36E\uAC1C \uC774\uC0C1 \uD655\uC778"
    instruction: "\uC810\uAC80 \uB2F4\uB2F9: WARN \uD45C\uC2DC\uB4F1\uC5D0\uC11C
