    instruction: "\uC815\uBE44 \uB2F4\uB2F9: \uBD89\uC740 GUARD\uB97C \uD074\uB9AD\uD574
      \uBC29\uD638 \uB36E\uAC1C\uB97C \uB2EB\uC73C\uC138\uC694. \uACF5\uAD6C\uB294
      \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4."
    toolId: 
    targetId: guard-cover
    action: 0
    durationSeconds: 1.5
    requiredRole: 2
  - id: secure-guard
    title: "\uBC29\uD638 \uB36E\uAC1C \uACE0\uC815"
