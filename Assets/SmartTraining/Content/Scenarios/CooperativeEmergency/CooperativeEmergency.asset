  id: cooperative-emergency
  title: "\uD611\uB3D9 \uBE44\uC0C1 \uC720\uB3C4\uB4F1 \uBCF5\uAD6C"
  steps:
  - id: plan-recovery
    title: "\uBCF5\uAD6C \uC21C\uC11C \uD655\uC778"
    instruction: "\uC9C4\uD589 \uB2F4\uB2F9: \uC544\uB798\uCABD CHECK \uD310\uC744
      \uD074\uB9AD\uD574 \uD6C8\uB828 \uC791\uC5C5 \uC21C\uC11C\uB97C \uD655\uC778\uD558\uC138\uC694."
    toolId: 
    targetId: recovery-plan
    action: 0
    durationSeconds: 1.5
    requiredRole: 8
  - id: isolate-power
    title: "\uD6C8\uB828\uC6A9 \uC804\uC6D0 \uCC28\uB2E8 \uD655\uC778"
    instruction: "\uC548\uC804 \uD655\uC778 \uB2F4\uB2F9: \uC544\uB798\uCABD POWER
      \uC2A4\uC704\uCE58\uC5D0\uC11C \uD6C8\uB828\uC6A9 \uC7A5\uBE44\uC758 \uC804\uC6D0
      \uCC28\uB2E8 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694."
    toolId: 
    targetId: power-isolation
    action: 0
    durationSeconds: 1.5
    requiredRole: 4
  - id: inspect-light
    title: "\uBE44\uC0C1 \uC720\uB3C4\uB4F1 \uC0C1\uD0DC \uD655\uC778"
    instruction: "\uC810\uAC80 \uB2F4\uB2F9: \uC67C\uCABD EXIT LIGHT\uC5D0\uC11C
      \uC720\uB3C4\uB4F1 \uC774\uC0C1 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694."
    toolId: 
    targetId: exit-light
    action: 0
    durationSeconds: 1.5
    requiredRole: 1
  - id: open-battery
    title: "\uBC30\uD130\uB9AC \uB36E\uAC1C \uB098\uC0AC \uD480\uAE30"
    instruction: "\uC815\uBE44 \uB2F4\uB2F9: \uB4DC\uB77C\uC774\uBC84\uB85C SCREW\uB97C
      \uD480\uC5B4 \uBC30\uD130\uB9AC \uAD50\uCCB4\uB97C \uC900\uBE44\uD558\uC138\uC694."
    toolId: screwdriver
    targetId: battery-screw
    action: 1
    durationSeconds: 1.5
    requiredRole: 2
  - id: replace-battery
    title: "\uD6C8\uB828\uC6A9 \uBC30\uD130\uB9AC \uAD50\uCCB4"
    instruction: "\uC815\uBE44 \uB2F4\uB2F9: \uAC00\uC6B4\uB370 BATTERY\uB97C \uD074\uB9AD\uD574
      \uC0C8 \uBC30\uD130\uB9AC\uB85C \uAD50\uCCB4\uD558\uC138\uC694. \uACF5\uAD6C\uB294
      \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4."
    toolId: 
    targetId: exit-battery
    action: 0
    durationSeconds: 1.5
    requiredRole: 2
  - id: close-battery
    title: "\uBC30\uD130\uB9AC \uB36E\uAC1C \uB098\uC0AC \uCCB4\uACB0"
    instruction: "\uC815\uBE44 \uB2F4\uB2F9: \uB4DC\uB77C\uC774\uBC84\uB85C SCREW\uB97C
      \uB2E4\uC2DC \uCCB4\uACB0\uD558\uC138\uC694."
    toolId: screwdriver
    targetId: battery-screw
    action: 2
    durationSeconds: 1.5
    requiredRole: 2
  - id: test-light
    title: "\uBE44\uC0C1 \uC720\uB3C4\uB4F1 \uC810\uB4F1 \uD655\uC778"
    instruction: "\uC810\uAC80 \uB2F4\uB2F9: TEST \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC720\uB3C4\uB4F1\uC774 \uCD08\uB85D\uC0C9\uC73C\uB85C \uBCF5\uAD6C\uB418\uB294\uC9C0
      \uD655\uC778\uD558\uC138\uC694."
    toolId: 
    targetId: exit-test
    action: 0
    durationSeconds: 1.5
    requiredRole: 1
